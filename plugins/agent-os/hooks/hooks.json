{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/agent-os-task-bridge\"",
            "timeout": 30,
            "statusMessage": "Connecting this task to Agent OS"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/agent-os-task-bridge\"",
            "timeout": 30,
            "statusMessage": "Recording Agent OS activity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/agent-os-task-bridge\"",
            "timeout": 30,
            "statusMessage": "Saving the Agent OS checkpoint"
          }
        ]
      }
    ]
  }
}
