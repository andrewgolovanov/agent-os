#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require "open3"
require "optparse"
require "rbconfig"
require "rubygems/version"
require "tempfile"
require_relative "../lib/agent_os/paths"
require_relative "../lib/agent_os/home_migrator"
require_relative "../lib/agent_os/project_registry"
require_relative "../lib/agent_os/slack_monitor_setup"
require_relative "../lib/agent_os/task_board"
require_relative "../lib/agent_os/updater"

module AgentOS
  class CLI
    DEFAULT_HOME = File.join(Dir.home, ".agent-os")
    CONFIG_FILES = %w[projects.yaml monitors.yaml task-bridge.yaml].freeze

    def initialize(arguments, out: $stdout, err: $stderr, environment: ENV)
      @arguments = arguments.dup
      @out = out
      @err = err
      @environment = environment
    end

    def run
      command = @arguments.shift
      case command
      when "init" then initialize_home
      when "bootstrap" then bootstrap_runtime
      when "migrate-home" then migrate_home
      when "doctor" then doctor
      when "validate" then validate
      when "audit-publication" then audit_publication
      when "activate" then activate_home
      when "install-plugin" then install_plugin
      when "onboard-project" then onboard_project
      when "relink-project" then relink_project
      when "configure-slack-monitor" then configure_slack_monitor
      when "update" then update
      else
        @out.puts usage
        command.nil? ? 0 : 2
      end
    rescue ArgumentError, OptionParser::ParseError => error
      @err.puts "Error: #{error.message}"
      2
    end

    private

    def initialize_home
      options = common_options(apply: false)
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os init [--home PATH] [--source PATH] [--apply]"
        add_common_options(parser, options)
        parser.on("--apply", "Create missing files after showing the plan") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      source = validated_root(options.fetch(:source), "source")
      home = validated_root(options.fetch(:home), "home", allow_missing: true)
      templates = CONFIG_FILES.to_h do |name|
        path = File.join(source, "config", "examples", name)
        raise ArgumentError, "missing config template: #{path}" unless File.file?(path)
        [name, path]
      end

      planned = init_plan(home, templates)
      @out.puts "Agent OS init plan"
      @out.puts "  source: #{source}"
      @out.puts "  home:   #{home}"
      planned.each { |item| @out.puts "  #{item.fetch(:action).to_s.upcase.ljust(8)} #{item.fetch(:path)}" }

      unless options.fetch(:apply)
        @out.puts "Preview only. Re-run with --apply to create the missing paths."
        return 0
      end

      apply_init(home, templates, source)
      @out.puts "Initialized Agent OS home at #{home}"
      0
    end

    def bootstrap_runtime
      options = common_options(apply: false, json: false, replace_source: false)
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os bootstrap [--home PATH] [--source PATH] [--replace-source] [--json] [--apply]"
        add_common_options(parser, options)
        parser.on("--replace-source", "Explicitly replace a valid development source pointer after preview") { options[:replace_source] = true }
        parser.on("--json", "Print the plan or result as JSON") { options[:json] = true }
        parser.on("--apply", "Initialize missing private state and repair stale packaged-runtime pointers") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      requested_source = validated_root(options.fetch(:source), "source")
      home = validated_root(options.fetch(:home), "home", allow_missing: true)
      templates = config_templates(requested_source)
      source_decision = bootstrap_source_decision(
        home,
        requested_source,
        replace_source: options.fetch(:replace_source)
      )
      active_decision = active_home_decision(home)
      plan = init_plan(home, templates).map do |item|
        next item unless item.fetch(:path) == File.join(home, "source-path")

        { action: source_decision.fetch(:action), path: item.fetch(:path) }
      end
      plan << {
        action: active_decision.fetch(:action),
        path: active_home_pointer,
        target: active_decision.fetch(:target)
      }
      payload = {
        schema_version: 1,
        applied: options.fetch(:apply),
        replace_source: options.fetch(:replace_source),
        source: source_decision.fetch(:source),
        requested_source: requested_source,
        home: home,
        plan: plan
      }

      unless options.fetch(:apply)
        print_bootstrap(payload, json: options.fetch(:json))
        return 0
      end

      apply_init(home, templates, source_decision.fetch(:source))
      write_pointer(File.join(home, "source-path"), source_decision.fetch(:source)) if source_decision.fetch(:action) == :replace
      write_pointer(active_home_pointer, home) if %i[create replace].include?(active_decision.fetch(:action))
      print_bootstrap(payload, json: options.fetch(:json))
      0
    end

    def doctor
      options = common_options(json: false, integrations: false)
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os doctor [--home PATH] [--source PATH] [--integrations] [--json]"
        add_common_options(parser, options)
        parser.on("--integrations", "Include optional Slack, Scheduled, and hook checks") { options[:integrations] = true }
        parser.on("--json") { options[:json] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      source = validated_root(options.fetch(:source), "source", allow_missing: true)
      home = validated_root(options.fetch(:home), "home", allow_missing: true)
      checks = doctor_checks(source, home, integrations: options.fetch(:integrations))
      ready = checks.none? { |check| check.fetch(:required) && !check.fetch(:ok) }
      result = {
        schema_version: 1,
        ready: ready,
        source: source,
        home: home,
        integrations_checked: options.fetch(:integrations),
        checks: checks
      }

      if options.fetch(:json)
        @out.puts JSON.pretty_generate(result)
      else
        @out.puts ready ? "Agent OS is ready" : "Agent OS needs attention"
        checks.each do |check|
          label = check.fetch(:ok) ? "OK" : check.fetch(:required) ? "MISSING" : "OPTIONAL"
          @out.puts "  #{label.ljust(8)} #{check.fetch(:name)} — #{check.fetch(:detail)}"
        end
      end
      ready ? 0 : 1
    end

    def activate_home
      options = { home: @environment["AGENT_OS_HOME"] || active_home_value || DEFAULT_HOME, apply: false, replace: false }
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os activate [--home PATH] [--replace] [--apply]"
        parser.on("--home PATH", "Private Agent OS home") { |value| options[:home] = value }
        parser.on("--replace", "Replace a different active-home pointer after preview") { options[:replace] = true }
        parser.on("--apply", "Write the active-home pointer") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      home = validated_root(options.fetch(:home), "home")
      pointer = active_home_pointer
      existing = File.file?(pointer) ? File.read(pointer).strip : nil
      if existing && existing != home && !options.fetch(:replace)
        raise ArgumentError, "active home already points to #{existing}; it was not overwritten"
      end

      @out.puts "Agent OS activation plan"
      action = existing == home ? "PRESERVE" : existing ? "REPLACE" : "CREATE"
      @out.puts "  #{action} #{pointer} -> #{home}"
      unless options.fetch(:apply)
        @out.puts "Preview only. Re-run with --apply to activate this home."
        return 0
      end

      write_pointer(pointer, home) unless existing == home
      @out.puts "Activated Agent OS home at #{home}"
      0
    end

    def migrate_home
      options = {
        source: Paths.source_root,
        from: active_home_value,
        home: DEFAULT_HOME,
        apply: false,
        json: false
      }
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os migrate-home [--from PATH] [--home PATH] [--source PATH] [--json] [--apply]"
        parser.on("--from PATH", "Existing private Agent OS home") { |value| options[:from] = value }
        parser.on("--home PATH", "New private Agent OS home") { |value| options[:home] = value }
        parser.on("--source PATH", "Runtime selected by the migrated home") { |value| options[:source] = value }
        parser.on("--json", "Print the plan or result as JSON") { options[:json] = true }
        parser.on("--apply", "Copy verified private state and switch the active-home pointer") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!
      raise ArgumentError, "no active home; pass --from PATH" if options[:from].to_s.empty?

      migrator = AgentOS::HomeMigrator.new(
        source: validated_root(options.fetch(:source), "source"),
        from: validated_root(options.fetch(:from), "from"),
        home: validated_root(options.fetch(:home), "home", allow_missing: true),
        active_home_pointer: active_home_pointer
      )
      result = migrator.migrate(apply: options.fetch(:apply))
      if options.fetch(:json)
        @out.puts JSON.pretty_generate(result)
      else
        print_home_migration(result)
      end
      0
    end

    def validate
      options = common_options
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os validate [--home PATH] [--source PATH]"
        add_common_options(parser, options)
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      source = validated_root(options.fetch(:source), "source")
      home = validated_root(options.fetch(:home), "home")
      environment = {
        "AGENT_OS_SOURCE_ROOT" => source,
        "AGENT_OS_HOME" => home,
        "AGENT_OS_TASK_ROOT" => File.join(home, "work")
      }
      commands = [
        [RbConfig.ruby, File.join(source, "tools", "validate-agent-os")],
        [File.join(source, "tools", "task-board"), "validate", "--root", File.join(home, "work")],
        [RbConfig.ruby, File.join(source, "test", "run.rb")],
        ["node", File.join(source, "test", "plugin_packages_test.mjs")],
        ["node", File.join(source, "test", "context_loop_smoke.mjs")]
      ]

      commands.each do |command|
        @out.puts "+ #{command.join(" ")}"
        return 1 unless system(environment, *command, chdir: source)
      end
      0
    end

    def audit_publication
      options = common_options
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os audit-publication [--source PATH]"
        parser.on("--source PATH", "Agent OS runtime or development checkout") { |value| options[:source] = value }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!
      source = validated_root(options.fetch(:source), "source")
      system({ "AGENT_OS_SOURCE_ROOT" => source }, File.join(source, "tools", "audit-publication"), chdir: source) ? 0 : 1
    end

    def install_plugin
      options = { source: Paths.source_root, apply: false }
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os install-plugin [--source PATH] [--apply]"
        parser.on("--source PATH", "Agent OS runtime or development checkout") { |value| options[:source] = value }
        parser.on("--apply", "Register the marketplace and install the plugin") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      source = validated_root(options.fetch(:source), "source")
      manifest = File.join(source, ".agents", "plugins", "marketplace.json")
      plugin_manifest = File.join(source, "plugins", "agent-os", ".codex-plugin", "plugin.json")
      raise ArgumentError, "missing Agent OS marketplace: #{manifest}" unless File.file?(manifest)
      raise ArgumentError, "missing Agent OS plugin: #{plugin_manifest}" unless File.file?(plugin_manifest)

      codex = find_executable("codex")
      raise ArgumentError, "Codex CLI is not available on PATH" unless codex

      marketplaces = codex_json(codex, "plugin", "marketplace", "list", "--json").fetch("marketplaces")
      existing_marketplace = marketplaces.find { |item| item.fetch("name") == "agent-os" }
      if existing_marketplace && File.expand_path(existing_marketplace.fetch("root")) != source
        existing_root = existing_marketplace.fetch("root")
        raise ArgumentError, "agent-os marketplace already points to #{existing_root}"
      end

      plugins = if existing_marketplace
                  codex_json(codex, "plugin", "list", "--marketplace", "agent-os", "--available", "--json")
                else
                  { "installed" => [] }
                end
      installed = plugins.fetch("installed").any? { |item| item.fetch("pluginId") == "agent-os@agent-os" }

      @out.puts "Agent OS plugin install plan"
      @out.puts "  #{existing_marketplace ? "PRESERVE" : "REGISTER"} marketplace agent-os -> #{source}"
      @out.puts "  #{installed ? "PRESERVE" : "INSTALL"}  agent-os@agent-os"
      unless options.fetch(:apply)
        @out.puts "Preview only. Re-run with --apply to install the plugin."
        return 0
      end

      return 1 unless existing_marketplace || system(codex, "plugin", "marketplace", "add", source, "--json")
      return 1 unless installed || system(codex, "plugin", "add", "agent-os@agent-os", "--json")

      @out.puts "Agent OS plugin is installed. Start a fresh Codex task to load it."
      0
    end

    def onboard_project
      options = common_options(apply: false, json: false, repository: nil, key: nil, display_name: nil)
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os onboard-project --repository PATH [--key KEY] [--display-name NAME] [--home PATH] [--source PATH] [--json] [--apply]"
        add_common_options(parser, options)
        parser.on("--repository PATH", "Existing Git repository or a directory inside it") { |value| options[:repository] = value }
        parser.on("--key KEY", "Lowercase kebab-case project key") { |value| options[:key] = value }
        parser.on("--display-name NAME", "Human-readable project name") { |value| options[:display_name] = value }
        parser.on("--json", "Print machine-readable preview or result") { options[:json] = true }
        parser.on("--apply", "Create the reviewed wrapper and registry entry") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!
      raise OptionParser::MissingArgument, "repository" if options[:repository].to_s.empty?

      source = validated_root(options.fetch(:source), "source")
      home = validated_root(options.fetch(:home), "home")
      outcome = AgentOS::ProjectRegistry.new(source: source, home: home).onboard(
        repository: options.fetch(:repository),
        key: options[:key],
        display_name: options[:display_name],
        apply: options.fetch(:apply)
      )
      if options.fetch(:json)
        @out.puts JSON.pretty_generate(outcome)
      else
        project = outcome.fetch(:project)
        repository = outcome.fetch(:repository)
        @out.puts options.fetch(:apply) ? "Agent OS project onboarding result" : "Agent OS project onboarding plan"
        @out.puts "  #{outcome.fetch(:action).upcase.ljust(8)} #{project.fetch(:key)} (#{project.fetch(:layout)})"
        @out.puts "  repository #{repository.fetch(:path)}"
        @out.puts "  HEAD #{repository.fetch(:head)} on #{repository.fetch(:checked_out_branch) || "detached HEAD"}"
        @out.puts "  remote #{repository.fetch(:remote) || "unknown"}"
        outcome.fetch(:files).each { |path| @out.puts "  file #{path}" }
        @out.puts "Preview only. Re-run with --apply after reviewing the exact topology." unless options.fetch(:apply)
      end
      0
    end

    def relink_project
      options = common_options(apply: false, json: false, repository: nil, key: nil, repository_id: nil)
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os relink-project --key KEY --repository PATH [--repository-id ID] [--home PATH] [--source PATH] [--json] [--apply]"
        add_common_options(parser, options)
        parser.on("--repository PATH", "Existing Git repository at its new local path") { |value| options[:repository] = value }
        parser.on("--key KEY", "Existing lowercase kebab-case project key") { |value| options[:key] = value }
        parser.on("--repository-id ID", "Repository id for a multi-repository project") { |value| options[:repository_id] = value }
        parser.on("--json", "Print machine-readable preview or result") { options[:json] = true }
        parser.on("--apply", "Replace only the reviewed registry and wrapper metadata paths") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!
      raise OptionParser::MissingArgument, "repository" if options[:repository].to_s.empty?
      raise OptionParser::MissingArgument, "key" if options[:key].to_s.empty?

      source = validated_root(options.fetch(:source), "source")
      home = validated_root(options.fetch(:home), "home")
      outcome = AgentOS::ProjectRegistry.new(source: source, home: home).relink(
        repository: options.fetch(:repository),
        key: options.fetch(:key),
        repository_id: options[:repository_id],
        apply: options.fetch(:apply)
      )
      if options.fetch(:json)
        @out.puts JSON.pretty_generate(outcome)
      else
        project = outcome.fetch(:project)
        repository = outcome.fetch(:repository)
        @out.puts options.fetch(:apply) ? "Agent OS project relink result" : "Agent OS project relink plan"
        @out.puts "  #{outcome.fetch(:action).upcase.ljust(8)} #{project.fetch(:key)} (#{project.fetch(:layout)})"
        @out.puts "  previous   #{outcome.fetch(:previous_path)}"
        @out.puts "  repository #{repository.fetch(:path)}"
        @out.puts "  HEAD #{repository.fetch(:head)} on #{repository.fetch(:checked_out_branch) || "detached HEAD"}"
        @out.puts "  remote #{repository.fetch(:remote) || "unknown"}"
        outcome.fetch(:files).each { |path| @out.puts "  file #{path}" }
        @out.puts "Preview only. Re-run with --apply after verifying the repository identity and exact path." unless options.fetch(:apply)
      end
      0
    end

    def configure_slack_monitor
      options = common_options(
        timezone: nil,
        days: AgentOS::SlackMonitorSetup::DEFAULT_DAYS,
        times: AgentOS::SlackMonitorSetup::DEFAULT_TIMES,
        replace: false,
        apply: false,
        json: false
      )
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os configure-slack-monitor [--home PATH] [--source PATH] [--timezone ZONE] [--days LIST] [--times LIST] [--replace] [--json] [--apply]"
        add_common_options(parser, options)
        parser.on("--timezone ZONE", "IANA timezone (defaults to the Agent OS registry)") { |value| options[:timezone] = value }
        parser.on("--days LIST", "Comma-separated weekday codes, for example MO,TU,WE,TH,FR") { |value| options[:days] = split_list(value, "days") }
        parser.on("--times LIST", "Comma-separated local times, for example 10:00,14:00,18:00") { |value| options[:times] = split_list(value, "times") }
        parser.on("--replace", "Replace only an existing agent-os-slack-monitor entry") { options[:replace] = true }
        parser.on("--json", "Print the plan or result as JSON") { options[:json] = true }
        parser.on("--apply", "Write the reviewed monitor configuration") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      source = validated_root(options.fetch(:source), "source")
      home = validated_root(options.fetch(:home), "home")
      timezone = options[:timezone] || registry_timezone(home) || local_timezone
      setup = AgentOS::SlackMonitorSetup.new(
        source: source,
        home: home,
        timezone: timezone,
        days: options.fetch(:days),
        times: options.fetch(:times)
      )
      result = options.fetch(:apply) ? setup.apply(replace: options.fetch(:replace)) : setup.plan(replace: options.fetch(:replace))
      if options.fetch(:apply) && result.fetch(:action) == "conflict"
        raise ArgumentError, "#{result.fetch(:monitor_key)} already differs; pass --replace only after reviewing the preview"
      end

      if options.fetch(:json)
        @out.puts JSON.pretty_generate(result.reject { |key, _value| key == :desired_monitor })
      else
        print_slack_monitor_result(result, applied: options.fetch(:apply))
      end
      0
    end

    def update
      options = { source: Paths.source_root, remote: "origin", apply: false, plugin: true, json: false }
      OptionParser.new do |parser|
        parser.banner = "Usage: agent-os update [--source PATH] [--remote NAME] [--no-plugin] [--json] [--apply]"
        parser.on("--source PATH", "Agent OS runtime or development checkout") { |value| options[:source] = value }
        parser.on("--remote NAME", "Git remote containing release tags") { |value| options[:remote] = value }
        parser.on("--no-plugin", "Do not inspect or refresh the Codex plugin") { options[:plugin] = false }
        parser.on("--json", "Print machine-readable update status") { options[:json] = true }
        parser.on("--apply", "Fast-forward to the latest release and refresh the plugin") { options[:apply] = true }
        parser.parse!(@arguments)
      end
      reject_extra_arguments!

      source = validated_root(options.fetch(:source), "source")
      updater = AgentOS::Updater.new(source: source, remote: options.fetch(:remote), environment: @environment)
      result = options.fetch(:apply) ? updater.apply(include_plugin: options.fetch(:plugin)) : updater.status(include_plugin: options.fetch(:plugin))

      if options.fetch(:json)
        @out.puts JSON.pretty_generate(result)
      else
        print_update_result(result, applied: options.fetch(:apply))
      end
      0
    end

    def print_update_result(result, applied:)
      source = result.fetch(:source)
      @out.puts applied ? "Agent OS update result" : "Agent OS update plan"
      if source.fetch(:configured)
        @out.puts "  core:   #{source.fetch(:current_version) || "development"} -> #{source.fetch(:latest_version)} (#{source.fetch(:action)})"
      else
        @out.puts "  core:   unavailable (#{source.fetch(:reason)})"
      end

      plugin = result.fetch(:plugin)
      @out.puts "  plugin: #{plugin.fetch(:action)}"
      @out.puts "  app:    Sparkle update feed; automatic install is user opt-in"
      @out.puts "Preview only. Re-run with --apply to update core and plugin." unless applied
      @out.puts "Start a fresh Codex task after a plugin refresh." if plugin.fetch(:updated, false)
    end

    def common_options(extra = {})
      { source: Paths.source_root, home: @environment["AGENT_OS_HOME"] || active_home_value || DEFAULT_HOME }.merge(extra)
    end

    def config_templates(source)
      CONFIG_FILES.to_h do |name|
        path = File.join(source, "config", "examples", name)
        raise ArgumentError, "missing config template: #{path}" unless File.file?(path)
        [name, path]
      end
    end

    def bootstrap_source_decision(home, requested_source, replace_source: false)
      pointer = File.join(home, "source-path")
      return { action: :create, source: requested_source } unless File.file?(pointer)

      current = File.read(pointer).strip
      return { action: :replace, source: requested_source } unless valid_source_root?(current)
      return { action: :preserve, source: current } if File.expand_path(current) == requested_source
      return { action: :replace, source: requested_source } if replace_source

      current_manifest = runtime_manifest(current)
      requested_manifest = runtime_manifest(requested_source)
      if current_manifest && requested_manifest
        current_version = Gem::Version.new(current_manifest.fetch("version"))
        requested_version = Gem::Version.new(requested_manifest.fetch("version"))
        return requested_version >= current_version ? { action: :replace, source: requested_source } : { action: :preserve, source: current }
      end

      return { action: :replace, source: requested_source } if current_manifest && requested_manifest.nil?

      { action: :preserve, source: current }
    rescue JSON::ParserError, KeyError, ArgumentError
      { action: :replace, source: requested_source }
    end

    def active_home_decision(home)
      pointer = active_home_pointer
      return { action: :create, target: home } unless File.file?(pointer)

      current = File.read(pointer).strip
      return { action: :preserve, target: current } if current == home
      return { action: :preserve, target: current } if valid_home_root?(current)

      { action: :replace, target: home }
    end

    def valid_source_root?(path)
      path.start_with?(File::SEPARATOR) && path != File::SEPARATOR &&
        File.executable?(File.join(path, "tools", "task-board")) &&
        File.file?(File.join(path, "config", "examples", "projects.yaml"))
    end

    def valid_home_root?(path)
      path.start_with?(File::SEPARATOR) && path != File::SEPARATOR && File.directory?(path)
    end

    def runtime_manifest(source)
      path = File.join(source, ".agent-os-runtime.json")
      File.file?(path) ? JSON.parse(File.read(path)) : nil
    end

    def write_pointer(path, target)
      FileUtils.mkdir_p(File.dirname(path))
      temporary = Tempfile.new([".#{File.basename(path)}", ".tmp"], File.dirname(path))
      begin
        temporary.chmod(0o600)
        temporary.write("#{target}\n")
        temporary.flush
        temporary.fsync
        temporary.close
        File.rename(temporary.path, path)
      ensure
        temporary.close! rescue nil
      end
    end

    def print_bootstrap(payload, json:)
      if json
        @out.puts JSON.pretty_generate(payload)
        return
      end

      @out.puts payload.fetch(:applied) ? "Agent OS bootstrap result" : "Agent OS bootstrap plan"
      @out.puts "  source: #{payload.fetch(:source)}"
      @out.puts "  home:   #{payload.fetch(:home)}"
      payload.fetch(:plan).each do |item|
        suffix = item[:target] ? " -> #{item.fetch(:target)}" : ""
        @out.puts "  #{item.fetch(:action).to_s.upcase.ljust(8)} #{item.fetch(:path)}#{suffix}"
      end
      @out.puts "Preview only. Re-run with --apply to prepare the bundled runtime." unless payload.fetch(:applied)
    end

    def print_home_migration(result)
      @out.puts result.fetch(:applied) ? "Agent OS home migration result" : "Agent OS home migration plan"
      @out.puts "  from:   #{result.fetch(:from)}"
      @out.puts "  home:   #{result.fetch(:home)}"
      @out.puts "  source: #{result.fetch(:source)}"
      result.fetch(:copies).each do |item|
        @out.puts "  COPY     #{item.fetch(:from)} -> #{item.fetch(:to)}"
      end
      pointer = result.fetch(:pointer)
      @out.puts "  REPLACE  #{pointer.fetch(:path)} -> #{pointer.fetch(:to)}"
      @out.puts "Preview only. Re-run with --apply after reviewing every path." unless result.fetch(:applied)
      @out.puts "Previous home preserved at #{result.fetch(:from)} for rollback."
    end

    def add_common_options(parser, options)
      parser.on("--source PATH", "Agent OS runtime or development checkout") { |value| options[:source] = value }
      parser.on("--home PATH", "Private Agent OS home") { |value| options[:home] = value }
    end

    def validated_root(path, label, allow_missing: false)
      value = path.to_s
      raise ArgumentError, "#{label} path must be absolute" unless value.start_with?(File::SEPARATOR)
      expanded = File.expand_path(value)
      raise ArgumentError, "#{label} path cannot be the filesystem root" if expanded == File::SEPARATOR
      raise ArgumentError, "#{label} path does not exist: #{expanded}" unless allow_missing || File.directory?(expanded)
      expanded
    end

    def init_plan(home, templates)
      paths = [home, File.join(home, "config"), File.join(home, "projects"), File.join(home, ".runtime")]
      planned = paths.map { |path| { action: File.exist?(path) ? :preserve : :create, path: path } }
      templates.each_key do |name|
        path = File.join(home, "config", name)
        planned << { action: File.exist?(path) ? :preserve : :create, path: path }
      end
      source_path = File.join(home, "source-path")
      planned << { action: File.exist?(source_path) ? :preserve : :create, path: source_path }
      work = File.join(home, "work")
      planned << { action: File.exist?(work) ? :preserve : :create, path: work }
      planned
    end

    def apply_init(home, templates, source)
      home_existed = File.exist?(home)
      FileUtils.mkdir_p([home, File.join(home, "config"), File.join(home, "projects"), File.join(home, ".runtime")])
      File.chmod(0o700, home) unless home_existed

      templates.each do |name, template|
        destination = File.join(home, "config", name)
        next if File.exist?(destination)
        content = File.read(template)
          .gsub("__AGENT_OS_HOME__", home)
          .gsub("__TIMEZONE__", local_timezone)
        File.write(destination, content, mode: "wx", perm: 0o600)
      end
      source_path = File.join(home, "source-path")
      File.write(source_path, "#{source}\n", mode: "wx", perm: 0o600) unless File.exist?(source_path)
      AgentOS::TaskBoard.new(File.join(home, "work")).initialize_store
    end

    def local_timezone
      @environment.fetch("TZ", "UTC").then { |value| value.empty? ? "UTC" : value }
    end

    def doctor_checks(source, home, integrations: false)
      required_paths = {
        "Agent OS runtime" => source,
        "source pointer" => File.join(home, "source-path"),
        "Task Board executable" => File.join(source, "tools", "task-board"),
        "project registry" => File.join(home, "config", "projects.yaml"),
        "Task Bridge config" => File.join(home, "config", "task-bridge.yaml"),
        "Task Board state" => File.join(home, "work", "board.json")
      }
      checks = required_paths.map do |name, path|
        { name: name, required: true, ok: File.exist?(path), detail: path }
      end
      checks << executable_check("Ruby", RbConfig.ruby, required: true)
      checks << executable_check("Node.js", "node", required: false)
      checks << executable_check("Codex CLI", "codex", required: false)
      checks << executable_check("Swift", "swift", required: false)
      active = active_home_pointer
      checks << {
        name: "active-home pointer",
        required: false,
        ok: File.file?(active) && File.read(active).strip == home,
        detail: active
      }
      checks.concat(integration_checks(source, home)) if integrations
      checks
    end

    def integration_checks(source, home)
      monitor_path = File.join(home, "config", "monitors.yaml")
      monitor_ok = begin
        payload = YAML.safe_load(File.read(monitor_path), permitted_classes: [], permitted_symbols: [], aliases: false)
        payload.is_a?(Hash) && payload.dig("monitors", AgentOS::SlackMonitorSetup::MONITOR_KEY, "enabled") == true
      rescue Errno::ENOENT, Psych::SyntaxError
        false
      end
      hook_manifest, hook_runner = task_bridge_hook_paths(source)
      runtime_pattern = File.join(home, ".runtime", "task-bridge", "sessions", "*", "turns", "*.json")
      runtime_evidence = Dir.glob(runtime_pattern).any?

      [
        {
          name: "Slack monitor configuration",
          required: false,
          ok: monitor_ok,
          detail: monitor_ok ? "enabled in #{monitor_path}" : "not enabled; preview agent-os configure-slack-monitor"
        },
        {
          name: "Task Bridge hook bundle",
          required: false,
          ok: File.file?(hook_manifest) && File.executable?(hook_runner),
          detail: "#{hook_manifest}; refresh the installed plugin, then review trust with /hooks"
        },
        {
          name: "Task Bridge runtime evidence",
          required: false,
          ok: runtime_evidence,
          detail: runtime_evidence ? "historical turn evidence exists; verify the current task separately" : "no historical turn evidence; start a fresh task after /hooks review"
        },
        {
          name: "connected Slack integration",
          required: false,
          ok: false,
          detail: "verify with a minimal read-only profile check in Codex; local CLI cannot inspect connector state"
        },
        {
          name: "Scheduled task",
          required: false,
          ok: false,
          detail: "verify in Codex Scheduled; local CLI does not own product automation state"
        }
      ]
    end

    def task_bridge_hook_paths(source)
      candidates = [
        File.join(source, "plugins", "agent-os", "hooks"),
        File.join(File.dirname(source), "hooks")
      ].uniq
      root = candidates.find do |candidate|
        File.file?(File.join(candidate, "hooks.json")) &&
          File.executable?(File.join(candidate, "agent-os-task-bridge"))
      end || candidates.first
      [File.join(root, "hooks.json"), File.join(root, "agent-os-task-bridge")]
    end

    def registry_timezone(home)
      path = File.join(home, "config", "projects.yaml")
      return nil unless File.file?(path)

      payload = YAML.safe_load(File.read(path), permitted_classes: [], permitted_symbols: [], aliases: false)
      value = payload.dig("agent_os", "timezone") if payload.is_a?(Hash)
      value.to_s.empty? ? nil : value.to_s
    rescue Psych::SyntaxError
      nil
    end

    def split_list(value, label)
      values = value.to_s.split(",", -1).map(&:strip)
      raise ArgumentError, "#{label} cannot contain empty values" if values.any?(&:empty?)
      values
    end

    def print_slack_monitor_result(result, applied:)
      schedule = result.fetch(:schedule)
      @out.puts applied ? "Agent OS Slack monitor result" : "Agent OS Slack monitor plan"
      @out.puts "  #{result.fetch(:action).upcase.ljust(8)} #{result.fetch(:config_path)}##{result.fetch(:monitor_key)}"
      @out.puts "  schedule #{schedule.fetch("days").join(",")} at #{schedule.fetch("local_times").join(",")} (#{schedule.fetch("timezone")})"
      if result.fetch(:action) == "conflict" && result[:existing_schedule].is_a?(Hash)
        existing = result.fetch(:existing_schedule)
        @out.puts "  existing #{Array(existing["days"]).join(",")} at #{Array(existing["local_times"]).join(",")} (#{existing["timezone"]})"
        @out.puts "  No changes made. Re-run the preview with --replace only after reviewing this conflict."
      end
      @out.puts "  authority read-only Slack; local Task Board preparation only"
      @out.puts "  Scheduled task is not created by this command. Use the Agent OS setup skill in Codex."
      @out.puts "Preview only. Re-run with --apply after review." unless applied
    end

    def active_home_pointer
      File.join(@environment.fetch("HOME", Dir.home), ".config", "agent-os", "home")
    end

    def active_home_value
      pointer = active_home_pointer
      return nil unless File.file?(pointer)

      value = File.read(pointer).strip
      value.start_with?(File::SEPARATOR) && value != File::SEPARATOR ? value : nil
    end

    def executable_check(name, executable, required:)
      path = if executable.include?(File::SEPARATOR)
               File.executable?(executable) ? executable : nil
             else
               find_executable(executable)
             end
      { name: name, required: required, ok: !path.nil?, detail: path || "not found on PATH" }
    end

    def find_executable(name)
      @environment.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |directory|
        candidate = File.join(directory, name)
        return candidate if File.file?(candidate) && File.executable?(candidate)
      end
      nil
    end

    def codex_json(codex, *arguments)
      stdout, stderr, status = Open3.capture3(codex, *arguments)
      raise ArgumentError, stderr.strip.empty? ? "Codex CLI command failed" : stderr.strip unless status.success?
      JSON.parse(stdout)
    rescue JSON::ParserError => error
      raise ArgumentError, "Codex CLI returned invalid JSON: #{error.message}"
    end

    def reject_extra_arguments!
      raise OptionParser::InvalidArgument, @arguments.join(" ") unless @arguments.empty?
    end

    def usage
      <<~USAGE
        Usage: agent-os <command> [options]

        Commands:
          init       Preview or create a private Agent OS home
          bootstrap  Prepare app/plugin bundled runtime and private state
          migrate-home  Copy legacy private state to a separate home and activate it
          doctor     Read-only dependency and path checks
          validate   Validate source structure and private state
          audit-publication  Block known private data from a release candidate
          activate   Preview or select the home used by app and plugin processes
          install-plugin  Preview or install the Agent OS Codex plugin
          onboard-project  Preview or register an existing Git repository
          relink-project  Preview or update the path of an already registered repository
          configure-slack-monitor  Preview or configure the optional read-only Slack monitor
          update     Check release tags; optionally fast-forward core and refresh plugin
      USAGE
    end
  end
end

exit AgentOS::CLI.new(ARGV).run if $PROGRAM_NAME == __FILE__
